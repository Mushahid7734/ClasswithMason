<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Academic Writing Master Guide for English Literature Students</title>
<style>
/* ===== SCOPED TO #lit-guide – never leaks ===== */
#lit-guide {
  --bg: #f8f6f1;
  --card: #ffffff;
  --text: #2c2a26;
  --muted: #5c584f;
  --accent: #3d5a4c;
  --accent2: #6b4e71;
  --soft: #e8e4dc;
  --highlight: #f0ebe3;
  --success: #3d6b4f;
  --warn: #8a5a2b;
  --border: #d9d3c7;
  --radius: 12px;
  --shadow: 0 2px 12px rgba(44,42,38,0.06);
  font-family: "Source Serif 4", "Georgia", "Times New Roman", serif;
  font-size: 16.5px;
  line-height: 1.65;
  color: var(--text);
  background: var(--bg);
  max-width: 820px;
  margin: 0 auto;
  padding: 0 1.2rem 3rem;
  box-sizing: border-box;
}
#lit-guide *, #lit-guide *::before, #lit-guide *::after { box-sizing: border-box; }
#lit-guide h1, #lit-guide h2, #lit-guide h3, #lit-guide h4 {
  font-family: "Inter", system-ui, -apple-system, sans-serif;
  font-weight: 700;
  color: var(--accent);
  line-height: 1.3;
  margin: 0 0 0.6em;
}
#lit-guide h1 { font-size: 1.85rem; letter-spacing: -0.02em; }
#lit-guide h2 { font-size: 1.4rem; margin-top: 2.2em; border-bottom: 2px solid var(--soft); padding-bottom: 0.35em; }
#lit-guide h3 { font-size: 1.15rem; color: var(--accent2); margin-top: 1.6em; }
#lit-guide h4 { font-size: 1.05rem; color: var(--muted); }
#lit-guide p { margin: 0 0 1em; }
#lit-guide a { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; }
#lit-guide a:hover { color: var(--accent2); }
#lit-guide ul, #lit-guide ol { margin: 0 0 1.1em; padding-left: 1.4em; }
#lit-guide li { margin-bottom: 0.4em; }

/* Header */
#lit-guide .lg-hero {
  background: linear-gradient(145deg, #3d5a4c 0%, #2f4a3e 100%);
  color: #f5f2eb;
  padding: 2rem 1.6rem;
  border-radius: 0 0 var(--radius) var(--radius);
  margin: 0 -1.2rem 2rem;
  text-align: center;
}
#lit-guide .lg-hero h1 { color: #fff; margin-bottom: 0.4em; }
#lit-guide .lg-hero p { opacity: 0.92; font-size: 1.05rem; max-width: 34em; margin: 0 auto 1.2em; }
#lit-guide .lg-hero-links { display: flex; flex-wrap: wrap; gap: 0.7rem; justify-content: center; }
#lit-guide .lg-btn {
  display: inline-flex; align-items: center; gap: 0.4rem;
  padding: 0.55rem 1.1rem; border-radius: 8px; font-weight: 600;
  font-size: 0.92rem; border: none; cursor: pointer;
  background: rgba(255,255,255,0.15); color: #fff;
  transition: background 0.2s;
  text-decoration: none;
}
#lit-guide .lg-btn:hover { background: rgba(255,255,255,0.28); }
#lit-guide .lg-btn-primary { background: #c9a86c; color: #2c2a26; }
#lit-guide .lg-btn-primary:hover { background: #d4b67a; }

/* Cards & sections */
#lit-guide .lg-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1.25rem 1.4rem;
  margin-bottom: 1.3rem;
  box-shadow: var(--shadow);
}
#lit-guide .lg-card.soft { background: var(--highlight); border-color: #e0d8cc; }
#lit-guide .lg-card.tip { border-left: 4px solid var(--success); }
#lit-guide .lg-card.warn { border-left: 4px solid var(--warn); }
#lit-guide .lg-icon {
  display: inline-flex; vertical-align: middle; margin-right: 0.4rem;
  width: 1.35em; height: 1.35em;
}
#lit-guide .lg-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 0.9rem;
  margin: 1rem 0;
}
#lit-guide .lg-chip {
  display: inline-block; padding: 0.22rem 0.65rem;
  background: var(--soft); border-radius: 999px;
  font-size: 0.82rem; margin: 0.15rem; color: var(--muted);
}

/* Accordion */
#lit-guide .lg-acc {
  border: 1px solid var(--border);
  border-radius: var(--radius);
  margin-bottom: 0.7rem;
  overflow: hidden;
  background: var(--card);
}
#lit-guide .lg-acc-head {
  padding: 0.95rem 1.2rem;
  cursor: pointer;
  display: flex; justify-content: space-between; align-items: center;
  font-weight: 700; font-family: "Inter", system-ui, sans-serif;
  color: var(--accent); background: var(--highlight);
  user-select: none; gap: 0.6rem;
}
#lit-guide .lg-acc-head:hover { background: var(--soft); }
#lit-guide .lg-acc-body { padding: 1.1rem 1.25rem; display: none; }
#lit-guide .lg-acc.open .lg-acc-body { display: block; }
#lit-guide .lg-chevron { transition: transform 0.25s; flex-shrink: 0; }
#lit-guide .lg-acc.open .lg-chevron { transform: rotate(180deg); }

/* Examples */
#lit-guide .lg-ex {
  background: #f3f0ea;
  border-radius: 8px;
  padding: 0.9rem 1.1rem;
  margin: 0.8rem 0;
  font-size: 0.97rem;
}
#lit-guide .lg-bad { color: #9b2c2c; text-decoration: line-through; }
#lit-guide .lg-good { color: var(--success); font-weight: 600; }

/* Table */
#lit-guide table {
  width: 100%; border-collapse: collapse; margin: 1rem 0;
  font-size: 0.92rem; background: var(--card);
}
#lit-guide th, #lit-guide td {
  border: 1px solid var(--border); padding: 0.55rem 0.7rem; text-align: left;
}
#lit-guide th { background: var(--highlight); font-weight: 700; color: var(--accent); }
#lit-guide tr:nth-child(even) { background: #faf8f4; }

/* Sticky nav */
#lit-guide .lg-nav {
  position: sticky; top: 0; z-index: 20;
  background: rgba(248,246,241,0.95); backdrop-filter: blur(8px);
  border-bottom: 1px solid var(--border);
  padding: 0.6rem 0; margin: 0 -1.2rem 1.5rem;
  display: flex; flex-wrap: wrap; gap: 0.4rem; justify-content: center;
}
#lit-guide .lg-nav a {
  font-family: "Inter", system-ui, sans-serif; font-size: 0.8rem;
  padding: 0.35rem 0.7rem; border-radius: 6px;
  background: var(--soft); color: var(--accent); text-decoration: none;
  font-weight: 600;
}
#lit-guide .lg-nav a:hover { background: var(--accent); color: #fff; }

/* Progress / interactive */
#lit-guide .lg-progress {
  height: 6px; background: var(--soft); border-radius: 3px;
  overflow: hidden; margin: 0.5rem 0 1.2rem;
}
#lit-guide .lg-progress-bar {
  height: 100%; background: var(--accent); width: 0%; transition: width 0.4s;
}
#lit-guide .lg-quiz-opt {
  display: block; width: 100%; text-align: left;
  padding: 0.6rem 0.9rem; margin: 0.35rem 0;
  border: 1px solid var(--border); border-radius: 8px;
  background: var(--card); cursor: pointer; font-size: 0.95rem;
  transition: all 0.15s;
}
#lit-guide .lg-quiz-opt:hover { border-color: var(--accent); background: var(--highlight); }

/* Footer */
#lit-guide .lg-footer {
  text-align: center; margin-top: 3rem; padding: 1.5rem;
  font-size: 0.85rem; color: var(--muted);
  border-top: 1px solid var(--border);
}
</style>
</head>
<body>

<div id="lit-guide">

  <!-- HERO -->
  <header class="lg-hero">
    <h1>
      <svg class="lg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/><path d="M8 7h8M8 11h6"/></svg>
      Academic Writing Master Guide
    </h1>
    <p>An exhaustive, interactive companion for English Literature students preparing essays, research papers, and theses that apply literary theory.</p>
    <div class="lg-hero-links">
      <a class="lg-btn lg-btn-primary" href="https://www.authormasoncarter.com/p/critical-literary-theory.html" target="_blank" rel="noopener">
        <svg class="lg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
        Critical Literary Theory Resource
      </a>
      <button class="lg-btn" id="lg-reset" title="Clear only this guide’s saved progress">
        <svg class="lg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
        Reset Progress
      </button>
    </div>
  </header>

  <!-- STICKY NAV -->
  <nav class="lg-nav">
    <a href="#styles">Citation Styles</a>
    <a href="#format">Paper Format</a>
    <a href="#language">Academic Language</a>
    <a href="#cohesion">Cohesive Devices</a>
    <a href="#structure">Paper & Thesis Structure</a>
    <a href="#analysis">Close Analysis</a>
    <a href="#theory">Theory & Framework</a>
    <a href="#quiz">Self-Check</a>
  </nav>

  <!-- ========== 1. CITATION STYLES ========== -->
  <section id="styles">
    <h2>
      <svg class="lg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/></svg>
      Major Citation Styles & Variations
    </h2>
    <p>Literature students most often use <strong>MLA</strong>, but you will encounter others. Always follow your instructor or target journal. Below is a clear comparison so you can switch confidently.</p>

    <div class="lg-card soft">
      <h3>Quick Decision Guide</h3>
      <ul>
        <li><strong>English / Comparative Literature / Cultural Studies</strong> → MLA 9 (author-page)</li>
        <li><strong>History / Art History</strong> → Chicago Notes-Bibliography (footnotes)</li>
        <li><strong>Psychology / Education / Social Sciences</strong> → APA 7 (author-date)</li>
        <li><strong>UK / Australia multidisciplinary</strong> → Harvard (author-date family; many institutional variants)</li>
        <li><strong>When in doubt for a literature paper</strong> → MLA</li>
      </ul>
    </div>

    <h3>Side-by-Side Comparison</h3>
    <table>
      <thead>
        <tr>
          <th>Feature</th>
          <th>MLA 9</th>
          <th>APA 7</th>
          <th>Chicago (NB)</th>
          <th>Harvard (typical)</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Primary field</td>
          <td>Literature, humanities</td>
          <td>Social sciences, psychology</td>
          <td>History, arts</td>
          <td>General (UK/AU)</td>
        </tr>
        <tr>
          <td>In-text</td>
          <td>(Author page)</td>
          <td>(Author, Year, p. x)</td>
          <td>Footnote¹</td>
          <td>(Author, Year, p. x)</td>
        </tr>
        <tr>
          <td>End list title</td>
          <td>Works Cited</td>
          <td>References</td>
          <td>Bibliography</td>
          <td>Reference List</td>
        </tr>
        <tr>
          <td>Author names</td>
          <td>Full first name</td>
          <td>Initials</td>
          <td>Full first name</td>
          <td>Initials (varies)</td>
        </tr>
        <tr>
          <td>Title capitalisation</td>
          <td>Title Case</td>
          <td>Sentence case (articles/books)</td>
          <td>Title Case</td>
          <td>Sentence or Title (institutional)</td>
        </tr>
        <tr>
          <td>Date placement</td>
          <td>Near end of entry</td>
          <td>Right after author</td>
          <td>In footnote / near end</td>
          <td>Right after author</td>
        </tr>
      </tbody>
    </table>

    <div class="lg-acc">
      <div class="lg-acc-head">
        <span>MLA 9 – Core rules for literature students</span>
        <svg class="lg-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
      </div>
      <div class="lg-acc-body">
        <p>Emphasises the <em>text</em> itself (author + page). Ideal for close reading.</p>
        <ul>
          <li>Works Cited: hanging indent, double-spaced, alphabetical</li>
          <li>Titles of longer works (books, journals, plays) → italics</li>
          <li>Titles of shorter works (articles, poems, chapters) → quotation marks</li>
          <li>DOI preferred over URL when available</li>
          <li>No “p.” or “pp.” in in-text citations; just the number</li>
        </ul>
        <div class="lg-ex">
          <strong>Book:</strong> Woolf, Virginia. <i>To the Lighthouse</i>. Harcourt, 1927.<br>
          <strong>In-text:</strong> (Woolf 42)
        </div>
      </div>
    </div>

    <div class="lg-acc">
      <div class="lg-acc-head">
        <span>APA 7 – When you need it</span>
        <svg class="lg-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
      </div>
      <div class="lg-acc-body">
        <p>Author-date system. Useful if your literature project intersects with psychology, education, or empirical methods.</p>
        <div class="lg-ex">
          Woolf, V. (1927). <i>To the lighthouse</i>. Harcourt.<br>
          In-text: (Woolf, 1927, p. 42)
        </div>
      </div>
    </div>

    <div class="lg-acc">
      <div class="lg-acc-head">
        <span>Chicago Notes-Bibliography – Footnotes & discursive notes</span>
        <svg class="lg-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
      </div>
      <div class="lg-acc-body">
        <p>Two systems exist. Literature and history usually prefer <strong>Notes-Bibliography</strong> (footnotes + Bibliography). Author-Date is closer to APA.</p>
        <div class="lg-ex">
          Footnote: ¹ Virginia Woolf, <i>To the Lighthouse</i> (New York: Harcourt, 1927), 42.<br>
          Bibliography: Woolf, Virginia. <i>To the Lighthouse</i>. New York: Harcourt, 1927.
        </div>
      </div>
    </div>

    <div class="lg-acc">
      <div class="lg-acc-head">
        <span>Harvard – The “family” of styles</span>
        <svg class="lg-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
      </div>
      <div class="lg-acc-body">
        <p>There is no single official Harvard manual. Each university publishes its own variant. Always download your department’s guide. Core pattern is author-date, similar to APA but with different punctuation and capitalisation rules.</p>
      </div>
    </div>

    <div class="lg-card tip">
      <strong>Pro tip:</strong> Once you choose a style, stay consistent. Mixing MLA in-text citations with an APA reference list is a common and costly error.
    </div>
  </section>

  <!-- ========== 2. PAPER FORMAT ========== -->
  <section id="format">
    <h2>
      <svg class="lg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
      Physical Format & Layout (All Styles)
    </h2>
    <p>These physical conventions are shared or very similar across major styles. Master them once.</p>

    <div class="lg-grid">
      <div class="lg-card">
        <h4>
          <svg class="lg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v16H4z"/><path d="M9 4v16"/></svg>
          Margins
        </h4>
        <p>1 inch (2.54 cm) on all four sides. Never reduce margins to squeeze extra text.</p>
      </div>
      <div class="lg-card">
        <h4>
          <svg class="lg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7V4h3M20 7V4h-3M4 17v3h3M20 17v3h-3"/><path d="M9 9h6v6H9z"/></svg>
          Font & Size
        </h4>
        <p>Readable serif or sans-serif (Times New Roman, Garamond, Arial, Calibri). 11–13 pt; 12 pt is the safe classic.</p>
      </div>
      <div class="lg-card">
        <h4>
          <svg class="lg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h10"/></svg>
          Spacing
        </h4>
        <p>Double-space the entire document (body, quotations, notes, Works Cited / References). No extra blank lines between paragraphs.</p>
      </div>
      <div class="lg-card">
        <h4>
          <svg class="lg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2z"/><path d="M12 11v6M9 14h6"/></svg>
          Indentation
        </h4>
        <p>First line of every paragraph: 0.5 inch (use Tab). Block quotations: entire block indented 0.5 inch, no quotation marks.</p>
      </div>
    </div>

    <div class="lg-acc">
      <div class="lg-acc-head">
        <span>Running header / page numbers</span>
        <svg class="lg-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
      </div>
      <div class="lg-acc-body">
        <ul>
          <li><strong>MLA:</strong> Last name + page number, top right, ½ inch from top edge (e.g., <code>Smith 3</code>)</li>
          <li><strong>APA:</strong> Page number top right; running head only for professional papers</li>
          <li><strong>Chicago:</strong> Page numbers usually top right or bottom centre; follow local guidelines</li>
        </ul>
      </div>
    </div>

    <div class="lg-acc">
      <div class="lg-acc-head">
        <span>First page vs. title page</span>
        <svg class="lg-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
      </div>
      <div class="lg-acc-body">
        <p><strong>MLA</strong> does not require a title page for student papers. Place name, instructor, course, and date (day Month year) at top left, double-spaced; centre the title; begin the essay immediately.</p>
        <p><strong>APA</strong> and many thesis formats do require a title page. Always check your handbook.</p>
      </div>
    </div>
  </section>

  <!-- ========== 3. ACADEMIC LANGUAGE ========== -->
  <section id="language">
    <h2>
      <svg class="lg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
      Academic Language Rules for Literature Students
    </h2>

    <div class="lg-acc open">
      <div class="lg-acc-head">
        <span>Avoid vague words and empty phrases</span>
        <svg class="lg-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
      </div>
      <div class="lg-acc-body">
        <div class="lg-ex">
          <span class="lg-bad">a lot of / lots of / many</span> → <span class="lg-good">numerous / several / the majority of / three distinct</span><br>
          <span class="lg-bad">things / stuff / aspects</span> → <span class="lg-good">motifs / formal features / narrative strategies / ideological tensions</span><br>
          <span class="lg-bad">good / bad / nice / interesting</span> → <span class="lg-good">effective / problematic / revealing / ambivalent</span><br>
          <span class="lg-bad">in today’s society / nowadays</span> → <span class="lg-good">in contemporary criticism / since the 1990s / within current debates</span><br>
          <span class="lg-bad">very / really / quite</span> → delete or replace with a precise intensifier only when essential
        </div>
      </div>
    </div>

    <div class="lg-acc">
      <div class="lg-acc-head">
        <span>Personal pronouns & point of view</span>
        <svg class="lg-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
      </div>
      <div class="lg-acc-body">
        <p>Literature essays traditionally favour a restrained third-person or carefully limited first-person voice.</p>
        <ul>
          <li>Avoid “I think / I believe / In my opinion” — the evidence should carry the claim.</li>
          <li>“We” can work when referring to a shared critical conversation or the reading process.</li>
          <li>Some contemporary theoretical writing accepts a reflective “I”; check your supervisor’s preference.</li>
        </ul>
        <div class="lg-ex">
          <span class="lg-bad">I believe that the ending is tragic.</span><br>
          <span class="lg-good">The final image of the empty room stages an unresolved mourning that the preceding chapters have prepared.</span>
        </div>
      </div>
    </div>

    <div class="lg-acc">
      <div class="lg-acc-head">
        <span>Adjectives, adverbs & unsupported claims</span>
        <svg class="lg-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
      </div>
      <div class="lg-acc-body">
        <p>Adjectives and adverbs should not introduce new evaluative claims that lack evidence.</p>
        <div class="lg-ex">
          <span class="lg-bad">This groundbreaking and revolutionary novel completely transforms our understanding of gender…</span><br>
          <span class="lg-good">The novel unsettles conventional gender binaries by placing the narrator’s desire outside the available social scripts.</span>
        </div>
        <p>Use evaluative language only when you have just demonstrated the feature that justifies it.</p>
      </div>
    </div>

    <div class="lg-acc">
      <div class="lg-acc-head">
        <span>Write concretely – prefer the specific over the abstract</span>
        <svg class="lg-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
      </div>
      <div class="lg-acc-body">
        <p>Abstract nouns (“the nature of identity”, “the question of power”) often conceal rather than clarify. Anchor claims in observable textual detail.</p>
        <div class="lg-ex">
          <span class="lg-bad">The novel explores the nature of identity.</span><br>
          <span class="lg-good">Through the repeated refusal of proper names, the novel stages identity as something performed under surveillance rather than possessed.</span>
        </div>
      </div>
    </div>

    <div class="lg-acc">
      <div class="lg-acc-head">
        <span>Avoid monotony: vary rhythm and openings</span>
        <svg class="lg-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
      </div>
      <div class="lg-acc-body">
        <ul>
          <li>Mix short and long sentences.</li>
          <li>Do not begin every sentence with “The” or “This”.</li>
          <li>Alternate active and passive voice deliberately (passive is useful when the agent is less important than the action or the text itself).</li>
          <li>Read paragraphs aloud; if you lose interest, the reader will too.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ========== 4. COHESIVE DEVICES ========== -->
  <section id="cohesion">
    <h2>
      <svg class="lg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
      Cohesive Devices – The Glue of Academic Prose
    </h2>
    <p>Cohesion makes a text feel continuous rather than a stack of isolated sentences. Literature students need both <strong>grammatical</strong> and <strong>lexical</strong> resources, plus a rich set of logical connectors (signposting).</p>

    <h3>1. Logical connectors (signposting)</h3>
    <div class="lg-grid">
      <div class="lg-card">
        <h4>Addition</h4>
        <p>furthermore, moreover, in addition, likewise, similarly, what is more, not only… but also</p>
      </div>
      <div class="lg-card">
        <h4>Contrast / Concession</h4>
        <p>however, nevertheless, nonetheless, conversely, on the other hand, by contrast, although, while, whereas, yet, still, despite this</p>
      </div>
      <div class="lg-card">
        <h4>Cause & Effect</h4>
        <p>therefore, thus, consequently, as a result, hence, accordingly, for this reason, because of this</p>
      </div>
      <div class="lg-card">
        <h4>Sequence / Time</h4>
        <p>first, second, subsequently, then, next, finally, meanwhile, at the same time, previously, thereafter</p>
      </div>
      <div class="lg-card">
        <h4>Example / Illustration</h4>
        <p>for instance, for example, specifically, to illustrate, in particular, namely</p>
      </div>
      <div class="lg-card">
        <h4>Emphasis / Clarification</h4>
        <p>indeed, in fact, notably, crucially, above all, that is, in other words, to put it another way</p>
      </div>
      <div class="lg-card">
        <h4>Summary / Conclusion</h4>
        <p>in sum, to summarise, overall, ultimately, in short, taken together</p>
      </div>
      <div class="lg-card">
        <h4>Comparison</h4>
        <p>similarly, in the same way, by the same token, equally, correspondingly</p>
      </div>
    </div>

    <div class="lg-card tip">
      <strong>Vary them.</strong> Repeating “however” six times in two pages creates monotony. Keep a mental toolkit and rotate.
    </div>

    <h3>2. Grammatical cohesion (Halliday & Hasan tradition)</h3>
    <div class="lg-acc">
      <div class="lg-acc-head">
        <span>Reference (anaphora, cataphora, demonstratives)</span>
        <svg class="lg-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
      </div>
      <div class="lg-acc-body">
        <p><strong>Anaphora</strong> points backward: “Woolf’s narrator… <em>She</em> repeatedly…”</p>
        <p><strong>Cataphora</strong> points forward: “When <em>he</em> finally speaks, the stranger reveals…”</p>
        <p>Demonstratives (<em>this, that, these, those</em>) and comparative reference (<em>the same, such, other</em>) also create ties.</p>
      </div>
    </div>
    <div class="lg-acc">
      <div class="lg-acc-head">
        <span>Substitution & Ellipsis</span>
        <svg class="lg-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
      </div>
      <div class="lg-acc-body">
        <p><strong>Substitution:</strong> replace a noun phrase or clause with <em>one, ones, do, so, the same</em>.</p>
        <p><strong>Ellipsis:</strong> omit words that are recoverable from context (“Some critics accept the reading; others do not [accept it].”).</p>
      </div>
    </div>

    <h3>3. Lexical cohesion</h3>
    <ul>
      <li><strong>Repetition</strong> of key terms (use sparingly and deliberately)</li>
      <li><strong>Synonymy / near-synonymy</strong> (power / authority / dominance)</li>
      <li><strong>Hyponymy</strong> (superordinate → specific: “narrative techniques… free indirect discourse”)</li>
      <li><strong>Collocation</strong> (words that naturally co-occur in the critical conversation)</li>
      <li><strong>Lexical chains</strong> that run through a paragraph or section, keeping the topic thread visible</li>
    </ul>
  </section>

  <!-- ========== 5. PAPER & THESIS STRUCTURE ========== -->
  <section id="structure">
    <h2>
      <svg class="lg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 6h16M4 12h16M4 18h10"/><path d="M18 18l3-3-3-3"/></svg>
      Structure of Essays, Papers & Theses
    </h2>

    <h3>Abstracts</h3>
    <div class="lg-grid">
      <div class="lg-card">
        <h4>Descriptive</h4>
        <p>~80–120 words. States purpose, scope, and method. No results or conclusions.</p>
      </div>
      <div class="lg-card">
        <h4>Informative</h4>
        <p>150–300 words. Purpose, method, key findings/arguments, implications. Most common in literature.</p>
      </div>
      <div class="lg-card">
        <h4>Structured</h4>
        <p>Labelled sections (Background, Methods, Results, Conclusions). More common in sciences; occasionally requested in interdisciplinary work.</p>
      </div>
    </div>
    <div class="lg-card soft">
      <strong>Parts of a strong informative abstract:</strong> (1) context, (2) research problem or question, (3) approach / theoretical lens, (4) main claims or findings, (5) contribution or implications. Write it last.
    </div>

    <h3>Introduction – the funnel</h3>
    <ol>
      <li>Broad context or critical conversation</li>
      <li>Narrower problem, debate, or textual focus</li>
      <li>Gap or limitation in existing readings</li>
      <li>Your research question or thesis statement</li>
      <li>Brief roadmap of the essay / chapters</li>
    </ol>

    <h3>Literature Review</h3>
    <p>Not a list of summaries. A critical synthesis that groups sources thematically or methodologically, identifies consensus, tensions, and gaps, and positions your own intervention.</p>
    <div class="lg-ex">
      “While earlier feminist readings emphasised X (Author A; Author B), more recent queer-theoretic work has shifted the focus toward Y (Author C). What remains under-examined is…”
    </div>

    <h3>Typical thesis / long-paper architecture (literature)</h3>
    <ul>
      <li>Introduction (problem, stakes, thesis, roadmap)</li>
      <li>Theoretical / methodological chapter or section (the lens you apply)</li>
      <li>Body chapters organised by theme, text, or conceptual problem (not by “summary then analysis”)</li>
      <li>Conclusion (restate contribution, acknowledge limits, open further questions)</li>
      <li>Works Cited / Bibliography</li>
    </ul>
    <p>Humanities theses often favour a sequence of thematic chapters rather than the rigid Introduction–Methods–Results–Discussion template of the sciences.</p>
  </section>

  <!-- ========== 6. CLOSE ANALYSIS ========== -->
  <section id="analysis">
    <h2>
      <svg class="lg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/><path d="M11 8v6M8 11h6"/></svg>
      Close Analysis Techniques
    </h2>
    <p>Close reading remains the foundational skill of literary study, even when theory is the explicit framework.</p>
    <ol>
      <li><strong>Select</strong> a short, charged passage, scene, image, or formal pattern.</li>
      <li><strong>Observe</strong> concrete features: diction, syntax, imagery, sound, point of view, narrative tempo, spatial arrangement, silence, repetition, rupture.</li>
      <li><strong>Interpret</strong> how those features produce meaning, affect, or ideological effect.</li>
      <li><strong>Connect</strong> the micro-observation back to the larger argument or theoretical claim.</li>
    </ol>
    <div class="lg-ex">
      “The repeated passive constructions in the final paragraph (‘was decided,’ ‘was implemented’) erase human agency and thereby enact, at the level of syntax, the bureaucratic violence the novel otherwise describes.”
    </div>
    <div class="lg-card tip">
      Always move from the specific textual detail outward. Theory should illuminate the text; the text should also pressure or refine the theory.
    </div>
  </section>

  <!-- ========== 7. THEORY & FRAMEWORK ========== -->
  <section id="theory">
    <h2>
      <svg class="lg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
      Theoretical Frameworks & Literary Theory
    </h2>
    <p>When you “apply a literary theory,” you are choosing a lens that organises what you notice and how you interpret it. A theoretical framework is not a decorative literature review; it is the set of concepts that make your argument possible.</p>

    <div class="lg-card soft">
      <h3 style="margin-top:0;">Essential companion resource</h3>
      <p>For clear, student-friendly explanations of the major critical approaches (New Criticism, Marxism, Feminism, Psychoanalysis, Postcolonialism, Queer Theory, Ecocriticism, and more), use:</p>
      <p style="text-align:center;margin:1.2em 0;">
        <a class="lg-btn lg-btn-primary" style="font-size:1rem;padding:0.7rem 1.4rem;" href="https://www.authormasoncarter.com/p/critical-literary-theory.html" target="_blank" rel="noopener">
          Critical Literary Theory → authormasoncarter.com
        </a>
      </p>
      <p>Return here for how to <em>deploy</em> those theories inside a paper or thesis.</p>
    </div>

    <h3>How to build and use a theoretical framework</h3>
    <ol>
      <li>Identify the problem or textual phenomenon that interests you.</li>
      <li>Survey candidate theories that have spoken to similar problems.</li>
      <li>Choose one primary anchoring theory (or a tightly limited pair). Avoid theory salad.</li>
      <li>Define the key concepts you will actually use (not every concept the theorist ever invented).</li>
      <li>Show how the theory generates your research questions or analytic categories.</li>
      <li>Let the text talk back: note where the theory fits smoothly and where it meets resistance.</li>
    </ol>

    <div class="lg-card tip">
      <strong>Underpinning citations:</strong> Do not merely drop a name. Show the conceptual work the citation is doing.<br>
      Weak: “Social media is addictive (Smith 2020).” (not literary, but the principle holds)<br>
      Stronger: “Drawing on Butler’s account of gender as performative, the novel’s repeated costume changes can be read as…”
    </div>
  </section>

  <!-- ========== 8. SELF-CHECK QUIZ ========== -->
  <section id="quiz">
    <h2>
      <svg class="lg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
      Quick Self-Check
    </h2>
    <p>Test a few essentials. Progress is stored only inside this guide.</p>
    <div class="lg-progress"><div class="lg-progress-bar" id="lg-prog"></div></div>
    <div id="lg-quiz-box" class="lg-card"></div>
    <button class="lg-btn" id="lg-next" style="display:none;margin-top:0.8rem;background:var(--accent);color:#fff;">Next →</button>
    <div id="lg-result" class="lg-card tip" style="display:none;margin-top:1rem;"></div>
  </section>

  <footer class="lg-footer">
    Academic Writing Master Guide for English Literature Students · Continuous interactive resource · Progress saved only in this widget’s localStorage · 
    <a href="https://www.authormasoncarter.com/p/critical-literary-theory.html" target="_blank" rel="noopener">Literary Theory companion</a>
  </footer>
</div>

<script>
(function(){
  'use strict';
  const R = document.getElementById('lit-guide');
  if(!R) return;
  const PREFIX = 'litguide_';

  // Accordions
  R.querySelectorAll('.lg-acc-head').forEach(h=>{
    h.addEventListener('click',()=> h.parentElement.classList.toggle('open'));
  });

  // Reset only this guide
  R.querySelector('#lg-reset').addEventListener('click',()=>{
    if(confirm('Clear only this guide’s saved quiz progress?')){
      Object.keys(localStorage).forEach(k=>{ if(k.startsWith(PREFIX)) localStorage.removeItem(k); });
      quizIdx=0; quizScore=0; renderQuiz();
      alert('Guide progress reset.');
    }
  });

  // Quiz
  const questions = [
    {q:'Which citation style is the default for most English literature papers?', opts:['APA 7','MLA 9','Chicago Author-Date','Harvard'], a:1, exp:'MLA 9 (author-page) is the standard in literature and the humanities.'},
    {q:'What is the standard margin size on all sides?', opts:['0.5 inch','1 inch','1.5 inches','2 cm'], a:1, exp:'1 inch (2.54 cm) on all four sides is the shared convention.'},
    {q:'A strong literature review should primarily be:', opts:['A chronological list of summaries','A critical synthesis organised by theme or debate','A full plot summary of primary texts','A collection of long quotations'], a:1, exp:'It must synthesise, group, and position sources, not merely summarise them.'},
    {q:'Which is the best replacement for the vague phrase “a lot of critics”?', opts:['many people','numerous scholars','lots of writers','various individuals'], a:1, exp:'“Numerous scholars” is more precise and academic in register.'},
    {q:'Signposting devices primarily help the reader by:', opts:['Adding decorative variety','Signalling logical relationships between ideas','Replacing the need for evidence','Making sentences longer'], a:1, exp:'They guide the reader through the argument’s logic (addition, contrast, cause, sequence, etc.).'},
    {q:'When applying a literary theory you should ideally:', opts:['Mention as many theorists as possible','Choose one primary anchoring lens and define the concepts you actually use','Avoid primary-text evidence','Write the theory section after the conclusion'], a:1, exp:'A focused framework is stronger than a scattered survey of names.'}
  ];
  let quizIdx = parseInt(localStorage.getItem(PREFIX+'idx')||'0',10);
  let quizScore = parseInt(localStorage.getItem(PREFIX+'score')||'0',10);

  function renderQuiz(){
    const box = R.querySelector('#lg-quiz-box');
    const prog = R.querySelector('#lg-prog');
    const next = R.querySelector('#lg-next');
    const res = R.querySelector('#lg-result');
    if(quizIdx >= questions.length){
      box.innerHTML = '';
      next.style.display = 'none';
      res.style.display = 'block';
      res.innerHTML = `<strong>Finished.</strong> Score: ${quizScore} / ${questions.length}.<br><button class="lg-btn" style="margin-top:0.8rem;background:var(--accent);color:#fff;" id="lg-restart">Restart</button>`;
      prog.style.width = '100%';
      R.querySelector('#lg-restart')?.addEventListener('click',()=>{
        quizIdx=0; quizScore=0;
        localStorage.setItem(PREFIX+'idx','0'); localStorage.setItem(PREFIX+'score','0');
        res.style.display='none'; renderQuiz();
      });
      return;
    }
    const q = questions[quizIdx];
    prog.style.width = ((quizIdx/questions.length)*100)+'%';
    box.innerHTML = `<p><strong>Question ${quizIdx+1} of ${questions.length}</strong></p><p>${q.q}</p><div id="lg-opts"></div><div id="lg-fb" style="display:none;margin-top:0.8rem;"></div>`;
    const opts = box.querySelector('#lg-opts');
    q.opts.forEach((o,i)=>{
      const b = document.createElement('button');
      b.className = 'lg-quiz-opt';
      b.textContent = o;
      b.addEventListener('click',()=>{
        const fb = box.querySelector('#lg-fb');
        fb.style.display = 'block';
        if(i===q.a){ quizScore++; fb.innerHTML = `<span class="lg-good">Correct.</span> ${q.exp}`; b.style.borderColor='var(--success)'; }
        else { fb.innerHTML = `<span class="lg-bad">Not quite.</span> ${q.exp}`; b.style.borderColor='var(--warn)'; opts.children[q.a].style.borderColor='var(--success)'; }
        opts.querySelectorAll('button').forEach(x=>x.disabled=true);
        next.style.display = 'inline-flex';
        localStorage.setItem(PREFIX+'score', quizScore);
      });
      opts.appendChild(b);
    });
    next.style.display = 'none';
  }
  R.querySelector('#lg-next').addEventListener('click',()=>{
    quizIdx++; localStorage.setItem(PREFIX+'idx', quizIdx); renderQuiz();
  });
  renderQuiz();
})();
</script>
</body>
